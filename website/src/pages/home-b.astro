---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { settings, sections, getFeatured, roman, itemUrl } from '../lib/items';
import { getSectionPanels, countLabel } from '../lib/home';

const panels = await getSectionPanels();
const featured = await getFeatured(6);
---

<Base direction="b" noindex>
  <header class="topbar wrap" slot="header">
    <div class="topbar__inner">
      <p class="label label--muted topbar__inst">{settings.institution}</p>
      <nav class="topbar__nav" aria-label="Main">
        <ul>
          {panels.map((p) => <li><a href={`/${p.key}/`}>{p.title}</a></li>)}
          <li class="topbar__break" aria-hidden="true"></li>
          <li class="topbar__gap"><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
      <ThemeToggle class="topbar__toggle" />
    </div>
  </header>

  <section class="wrap hero">
    <h1 class="hero__name">{settings.name}</h1>
    <div class="hero__meta">
      <ul class="hero__affil">
        {settings.affiliations.map((a) => <li>{a}</li>)}
        <li>{settings.institution}</li>
      </ul>
      <p class="hero__interests"><T text={settings.interests} /></p>
    </div>
  </section>

  <section class="wrap" aria-label="Sections of work">
    <ul class="rooms">
      {
        panels.map((p) => (
          <li class="rooms__item">
            <a class="room" href={`/${p.key}/`} data-panel>
              {p.image && (
                <div class="room__media" aria-hidden="true">
                  <Image src={p.image} alt="" widths={[480, 760, 1100, 1500]} sizes="(min-width: 900px) 50vw, 94vw" format="webp" quality={76} loading="lazy" />
                </div>
              )}
              <div class="room__top">
                <span class="room__num">{roman(p.index)}</span>
                <span class="room__count label">{countLabel(p.count)}</span>
              </div>
              <div class="room__bottom">
                <h2 class="room__title">{p.title}</h2>
                <div class="room__reveal">
                  <div>
                    <p class="room__desc"><T text={p.description} /></p>
                    <p class="room__cta label">Enter<span aria-hidden="true"> &rarr;</span></p>
                  </div>
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    featured.length > 0 && (
      <section class="wrap index" aria-labelledby="index-heading">
        <div class="index__head">
          <h2 id="index-heading" class="index__title">Selected work</h2>
          <p class="label label--muted">{featured.length} entries</p>
        </div>
        <ol class="index__list">
          {featured.map((item, i) => (
            <li class="reveal" style={`--delay:${i * 80}ms`}>
              <a class="row" href={itemUrl(item)}>
                <span class="row__year">{item.data.date.getUTCFullYear()}</span>
                <span class="row__title"><T text={item.data.title} /></span>
                <span class="row__meta label">
                  <span>{sections[item.collection].title}<span class="visually-hidden">,</span></span>
                  <span class="row__type">{item.data.type}</span>
                </span>
                <span class="row__thumb" aria-hidden="true">
                  <Image src={item.data.cover} alt="" widths={[240, 480]} sizes="160px" format="webp" quality={76} />
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</Base>

<script>
  const canHover = window.matchMedia('(hover: hover)').matches;
  const panels = document.querySelectorAll<HTMLAnchorElement>('[data-panel]');
  if (!canHover) {
    panels.forEach((panel) => {
      panel.addEventListener('click', (event) => {
        if (!panel.classList.contains('is-open')) {
          event.preventDefault();
          panels.forEach((other) => other.classList.remove('is-open'));
          panel.classList.add('is-open');
        }
      });
    });
  }
</script>

<style>
  :global(:root[data-direction='b']) {
    --font-display: 'Fraunces Variable', 'Iowan Old Style', Georgia, serif;
    --font-body: 'Public Sans Variable', 'Segoe UI', system-ui, sans-serif;
    --display-weight: 340;
  }

  /* Top bar */
  .topbar__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'inst nav toggle';
    align-items: center;
    gap: var(--space-3) clamp(1rem, 2.5vw, 2rem);
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .topbar__inst {
    grid-area: inst;
    margin: 0;
  }

  .topbar__nav {
    grid-area: nav;
    display: flex;
    justify-content: flex-end;
  }

  .topbar :global(.topbar__toggle) {
    grid-area: toggle;
  }

  .topbar__nav ul {
    display: flex;
    gap: clamp(0.9rem, 2vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .topbar__break {
    display: none;
  }

  .topbar__gap {
    margin-left: clamp(0.5rem, 2vw, 1.5rem);
    padding-left: clamp(1rem, 2.5vw, 2rem);
    border-left: 1px solid var(--rule-strong);
  }

  .topbar__nav a {
    display: inline-block;
    padding: 0.6rem 0;
    font-size: 0.85rem;
    color: var(--ink);
    text-decoration: none;
    background: linear-gradient(var(--brass), var(--brass)) no-repeat 0 calc(100% - 0.45rem) / 0 1px;
    transition: background-size var(--medium) var(--ease);
  }

  .topbar__nav a:hover,
  .topbar__nav a:focus-visible {
    background-size: 100% 1px;
  }

  /* Hero */
  .hero {
    padding-top: clamp(3rem, 9vw, 7.5rem);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .hero__name {
    font-size: clamp(3rem, 9.4vw, 8.75rem);
    font-weight: 320;
    font-variation-settings: 'opsz' 144;
    letter-spacing: -0.025em;
    line-height: 0.98;
    max-width: 12ch;
  }

  .hero__meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--space-5);
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule-strong);
  }

  .hero__affil {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--muted);
    font-size: 0.95rem;
    display: grid;
    gap: 0.2rem;
  }

  .hero__affil li:first-child {
    color: var(--ink);
  }

  .hero__interests {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.4vw + 1rem, 2rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.3;
    color: var(--ink-soft);
    margin: 0;
    max-width: 30ch;
  }

  /* Rooms */
  .rooms {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    height: clamp(400px, 56vh, 580px);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .rooms__item {
    flex: 1 1 0;
    min-width: 0;
    transition: flex-grow 1100ms var(--ease);
  }

  .rooms__item + .rooms__item {
    border-left: 1px solid var(--rule-strong);
  }

  .rooms__item:has(.room:hover),
  .rooms__item:has(.room:focus-visible),
  .rooms__item:has(.room.is-open) {
    flex-grow: 1.75;
  }

  .room {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: clamp(1.25rem, 2.2vw, 2rem);
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
  }

  .room__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    transform: scale(1.05);
    transition: opacity var(--slow) var(--ease), transform 1800ms var(--ease);
  }

  .room__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .room__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(var(--scrim) / 0.85), rgb(var(--scrim) / 0.3) 65%);
  }

  .room__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .room__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--brass-text);
    transition: color var(--slow) var(--ease);
  }

  .room__count {
    color: var(--muted);
    white-space: nowrap;
    transition: color var(--slow) var(--ease);
  }

  .room__title {
    font-size: clamp(1.7rem, 2.3vw, 2.5rem);
    font-weight: 340;
    letter-spacing: -0.01em;
    line-height: 1;
    transition: color var(--slow) var(--ease);
  }

  .room__reveal {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows var(--slow) var(--ease), opacity var(--slow) var(--ease) 150ms;
  }

  .room__reveal > div {
    overflow: hidden;
  }

  .room__desc {
    margin: 1rem 0 0.3rem;
    max-width: 34ch;
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .room__cta {
    margin: 0.6rem 0 0;
    color: inherit;
  }

  .room:hover .room__media,
  .room:focus-visible .room__media,
  .room.is-open .room__media {
    opacity: 1;
    transform: scale(1);
  }

  .room:hover :is(.room__title, .room__num, .room__count, .room__desc, .room__cta),
  .room:focus-visible :is(.room__title, .room__num, .room__count, .room__desc, .room__cta),
  .room.is-open :is(.room__title, .room__num, .room__count, .room__desc, .room__cta) {
    color: var(--on-image);
  }

  .room:hover .room__reveal,
  .room:focus-visible .room__reveal,
  .room.is-open .room__reveal {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .room :global(mark.ph) {
    color: var(--ph-ink) !important;
  }

  .room:focus-visible {
    outline-offset: -6px;
    outline-color: var(--on-image);
  }

  /* Selected work index */
  .index {
    margin-top: var(--space-7);
  }

  .index__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--ink);
  }

  .index__title {
    font-size: clamp(1.8rem, 2vw + 1rem, 2.6rem);
    font-weight: 340;
  }

  .index__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) minmax(0, 15rem) 8rem;
    align-items: center;
    gap: var(--space-4);
    padding: 1.1rem 0.75rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--medium) var(--ease);
  }

  .row:hover,
  .row:focus-visible {
    background: var(--paper-raised);
  }

  .row__year {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-variant-numeric: oldstyle-nums;
    color: var(--muted);
  }

  .row__title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 0.8vw + 1rem, 1.55rem);
    line-height: 1.25;
  }

  .row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.8rem;
  }

  .row__type {
    color: var(--muted);
  }

  .row__thumb {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--paper-sunk);
    opacity: 0.35;
    filter: grayscale(1);
    transition: opacity var(--medium) var(--ease), filter var(--medium) var(--ease);
  }

  .row__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .row:hover .row__thumb,
  .row:focus-visible .row__thumb {
    opacity: 1;
    filter: none;
  }

  @media (max-width: 900px) {
    .topbar__inner {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'inst toggle' 'nav nav';
      row-gap: 0;
    }

    .topbar__nav {
      justify-content: flex-start;
      border-top: 1px solid var(--rule);
    }

    .topbar__nav ul {
      flex-wrap: wrap;
      gap: 0 1.1rem;
    }

    .topbar__gap {
      margin-left: 0;
      padding-left: 0;
      border-left: 0;
    }

    .topbar__break {
      display: block;
      flex-basis: 100%;
      height: 0;
    }

    .hero__meta {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .rooms {
      flex-direction: column;
      height: auto;
    }

    .rooms__item + .rooms__item {
      border-left: 0;
      border-top: 1px solid var(--rule-strong);
    }

    .room {
      min-height: 150px;
      transition: min-height 1000ms var(--ease);
    }

    .room.is-open,
    .room:focus-visible {
      min-height: 340px;
    }

    .row {
      grid-template-columns: 3.5rem minmax(0, 1fr) 5.5rem;
      grid-template-areas: 'year title thumb' 'year meta thumb';
      row-gap: 0.35rem;
      padding-inline: 0;
    }

    .row__year {
      grid-area: year;
      align-self: start;
    }

    .row__title {
      grid-area: title;
    }

    .row__meta {
      grid-area: meta;
    }

    .row__thumb {
      grid-area: thumb;
      opacity: 1;
      filter: none;
    }
  }

  @media (max-width: 900px) and (hover: hover) {
    .room:hover {
      min-height: 340px;
    }
  }
</style>
